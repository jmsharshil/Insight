{
    "workbench.colorCustomizations": {
        "editor.background": "#1d2026",
        "editor.foreground": "#D6DAE0",
        "editorLineNumber.foreground": "#6A737D",
        "editorLineNumber.activeForeground": "#5FB0FF",
        "editorCursor.foreground": "#6fb3f5",
        "editor.selectionBackground": "#5FB0FF33",
        "editor.lineHighlightBackground": "#5FB0FF14",
        "activityBar.background": "#191b20",
        "activityBar.foreground": "#D6DAE0",
        "activityBar.activeBorder": "#69aac9",
        "activityBarBadge.background": "#6db3f6",
        "activityBarBadge.foreground": "#0b0d10",
        "sideBar.background": "#191b20",
        "sideBar.foreground": "#D6DAE0",
        "sideBarTitle.foreground": "#D6DAE0",
        "sideBarSectionHeader.background": "#1B1E23",
        "statusBar.background": "#426e70",
        "statusBar.foreground": "#D6DAE0",
        "statusBar.debuggingBackground": "#cba438",
        "titleBar.activeBackground": "#191b20",
        "titleBar.activeForeground": "#D6DAE0",
        "tab.activeBackground": "#1B1E23",
        "tab.inactiveBackground": "#15171B",
        "tab.activeBorderTop": "#58b2da",
        "terminal.background": "#1B1E23",
        "terminal.foreground": "#D6DAE0",
        "terminal.ansiGreen": "#3FB950",
        "terminal.ansiYellow": "#D4A72C",
        "terminal.ansiRed": "#F85149",
        "terminal.ansiBlue": "#B792F5",
        "button.background": "#6fa9ea",
        "button.foreground": "#0b0d10",
        "focusBorder": "#5FB0FF",
        "gitDecoration.modifiedResourceForeground": "#b5ab34",
        "gitDecoration.addedResourceForeground": "#3FB950",
        "gitDecoration.deletedResourceForeground": "#e75c56",
        "badge.background": "#5FB0FF",
        "progressBar.background": "#5FB0FF",
        "editorError.foreground": "#9c8e8f",
        "editorWarning.foreground": "#a0946f",
        "breadcrumb.activeSelectionForeground": "#62a7d5"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#6A737D",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string"
                ],
                "settings": {
                    "foreground": "#8FCB7E"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#FF7EB6"
                }
            },
            {
                "scope": [
                    "entity.name.function"
                ],
                "settings": {
                    "foreground": "#5FB0FF"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#B792F5"
                }
            },
            {
                "scope": [
                    "variable"
                ],
                "settings": {
                    "foreground": "#D6DAE0"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#D4A72C"
                }
            },
            {
                "scope": [
                    "invalid"
                ],
                "settings": {
                    "foreground": "#9c8e8f"
                }
            }
        ]
    }
}