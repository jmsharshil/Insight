{
    "workbench.colorCustomizations": {
        "editor.background": "#140f0f",
        "editor.foreground": "#E8E8E8",
        "editorLineNumber.foreground": "#5A5A5A",
        "editorLineNumber.activeForeground": "#FF7A1A",
        "editorCursor.foreground": "#d18346",
        "editor.selectionBackground": "#FF7A1A33",
        "editor.lineHighlightBackground": "#FF7A1A14",
        "activityBar.background": "#0e0908",
        "activityBar.foreground": "#E8E8E8",
        "activityBar.activeBorder": "#d87f33",
        "activityBarBadge.background": "#d2824c",
        "activityBarBadge.foreground": "#0b0d10",
        "sideBar.background": "#0e0908",
        "sideBar.foreground": "#E8E8E8",
        "sideBarTitle.foreground": "#E8E8E8",
        "sideBarSectionHeader.background": "#050505",
        "statusBar.background": "#497150",
        "statusBar.foreground": "#E8E8E8",
        "statusBar.debuggingBackground": "#FFB020",
        "titleBar.activeBackground": "#0e0908",
        "titleBar.activeForeground": "#E8E8E8",
        "tab.activeBackground": "#050505",
        "tab.inactiveBackground": "#000000",
        "tab.activeBorderTop": "#c97f33",
        "terminal.background": "#050505",
        "terminal.foreground": "#E8E8E8",
        "terminal.ansiGreen": "#8AD98A",
        "terminal.ansiYellow": "#FFB020",
        "terminal.ansiRed": "#FF3B3B",
        "terminal.ansiBlue": "#7A2AD9",
        "button.background": "#fc7920",
        "button.foreground": "#0b0d10",
        "focusBorder": "#FF7A1A",
        "gitDecoration.modifiedResourceForeground": "#d7b22a",
        "gitDecoration.addedResourceForeground": "#8AD98A",
        "gitDecoration.deletedResourceForeground": "#FF3B3B",
        "badge.background": "#FF7A1A",
        "progressBar.background": "#ed8737",
        "editorError.foreground": "#eb5953",
        "editorWarning.foreground": "#cca436",
        "breadcrumb.activeSelectionForeground": "#e0733e"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#5A5A5A",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string"
                ],
                "settings": {
                    "foreground": "#D9A87A"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#7A2AD9"
                }
            },
            {
                "scope": [
                    "entity.name.function"
                ],
                "settings": {
                    "foreground": "#4B8B3B"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#d46954"
                }
            },
            {
                "scope": [
                    "variable"
                ],
                "settings": {
                    "foreground": "#E8E8E8"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#FFB020"
                }
            }
        ]
    }
}