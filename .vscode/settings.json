{
    "workbench.colorCustomizations": {
        "editor.background": "#181e20",
        "editor.foreground": "#D9E7EC",
        "editorLineNumber.foreground": "#4E6B76",
        "editorLineNumber.activeForeground": "#3DA5D9",
        "editorCursor.foreground": "#70a3aa",
        "editor.selectionBackground": "#3DA5D933",
        "editor.lineHighlightBackground": "#3DA5D914",
        "activityBar.background": "#151819",
        "activityBar.foreground": "#D9E7EC",
        "activityBar.activeBorder": "#6e979b",
        "activityBarBadge.background": "#8e9993",
        "activityBarBadge.foreground": "#0b0d10",
        "sideBar.background": "#151819",
        "sideBar.foreground": "#D9E7EC",
        "sideBarTitle.foreground": "#D9E7EC",
        "sideBarSectionHeader.background": "#0E1B24",
        "statusBar.background": "#4c7f5b",
        "statusBar.foreground": "#D9E7EC",
        "statusBar.debuggingBackground": "#ceac47",
        "titleBar.activeBackground": "#151819",
        "titleBar.activeForeground": "#D9E7EC",
        "tab.activeBackground": "#0E1B24",
        "tab.inactiveBackground": "#0A141B",
        "tab.activeBorderTop": "#5e9a9e",
        "terminal.background": "#0E1B24",
        "terminal.foreground": "#D9E7EC",
        "terminal.ansiGreen": "#5FAE6B",
        "terminal.ansiYellow": "#D9B23D",
        "terminal.ansiRed": "#D9573D",
        "terminal.ansiBlue": "#5FAE6B",
        "button.background": "#529fc8",
        "button.foreground": "#0b0d10",
        "focusBorder": "#3DA5D9",
        "gitDecoration.modifiedResourceForeground": "#b9b341",
        "gitDecoration.addedResourceForeground": "#5FAE6B",
        "gitDecoration.deletedResourceForeground": "#cd624c",
        "badge.background": "#3DA5D9",
        "progressBar.background": "#51a9d1",
        "editorError.foreground": "#959292",
        "editorWarning.foreground": "#9d9274",
        "breadcrumb.activeSelectionForeground": "#62a7d5"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#4E6B76",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string"
                ],
                "settings": {
                    "foreground": "#8FCB9A"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#3DA5D9"
                }
            },
            {
                "scope": [
                    "entity.name.function"
                ],
                "settings": {
                    "foreground": "#4B8B3B"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#d46954"
                }
            },
            {
                "scope": [
                    "variable"
                ],
                "settings": {
                    "foreground": "#D9E7EC"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#D9B23D"
                }
            },
            {
                "scope": [
                    "invalid"
                ],
                "settings": {
                    "foreground": "#959292"
                }
            }
        ]
    }
}