{
    "workbench.colorCustomizations": {
        "editor.background": "#151821",
        "editor.foreground": "#D9E0FF",
        "editorLineNumber.foreground": "#4E5A80",
        "editorLineNumber.activeForeground": "#00E5FF",
        "editorCursor.foreground": "#33cbd9",
        "editor.selectionBackground": "#00E5FF33",
        "editor.lineHighlightBackground": "#00E5FF14",
        "activityBar.background": "#11131c",
        "activityBar.foreground": "#D9E0FF",
        "activityBar.activeBorder": "#27cfc9",
        "activityBarBadge.background": "#39c7de",
        "activityBarBadge.foreground": "#0b0d10",
        "sideBar.background": "#11131c",
        "sideBar.foreground": "#D9E0FF",
        "sideBarTitle.foreground": "#D9E0FF",
        "sideBarSectionHeader.background": "#0D0F1A",
        "statusBar.background": "#3d696e",
        "statusBar.foreground": "#D9E0FF",
        "statusBar.debuggingBackground": "#f7cc09",
        "titleBar.activeBackground": "#11131c",
        "titleBar.activeForeground": "#D9E0FF",
        "tab.activeBackground": "#0D0F1A",
        "tab.inactiveBackground": "#090B14",
        "tab.activeBorderTop": "#16d0c2",
        "terminal.background": "#0D0F1A",
        "terminal.foreground": "#D9E0FF",
        "terminal.ansiGreen": "#00FFA0",
        "terminal.ansiYellow": "#FFD400",
        "terminal.ansiRed": "#FF2E5D",
        "terminal.ansiBlue": "#FF2E97",
        "button.background": "#1cd7ea",
        "button.foreground": "#0b0d10",
        "focusBorder": "#00E5FF",
        "gitDecoration.modifiedResourceForeground": "#d7ce11",
        "gitDecoration.addedResourceForeground": "#00FFA0",
        "gitDecoration.deletedResourceForeground": "#fc355a",
        "badge.background": "#00E5FF",
        "progressBar.background": "#00E5FF",
        "editorError.foreground": "#f1554e",
        "editorWarning.foreground": "#d0a531"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#4E5A80",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string"
                ],
                "settings": {
                    "foreground": "#8AE0FF"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#FF2E97"
                }
            },
            {
                "scope": [
                    "entity.name.function"
                ],
                "settings": {
                    "foreground": "#4B8B3B"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#FF2E97"
                }
            },
            {
                "scope": [
                    "variable"
                ],
                "settings": {
                    "foreground": "#D9E0FF"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#FFD400"
                }
            },
            {
                "scope": [
                    "invalid"
                ],
                "settings": {
                    "foreground": "#f1554e"
                }
            }
        ]
    }
}